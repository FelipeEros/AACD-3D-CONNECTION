# Copie para .env e preencha. NUNCA envie o .env para o Git.
PORT=3000
NODE_ENV=development

# Projeto Supabase existente (Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Chave privilegiada: SOMENTE no servidor. Necessária apenas para
# cadastro de instituição e vínculo/criação de contas após aprovação.
SUPABASE_SERVICE_ROLE_KEY=

# Origens do Frontend autorizadas (separadas por vírgula)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Tamanho máximo de anexo em MB
UPLOAD_MAX_MB=50
